# Copy to .env for local overrides. Never commit .env.
# All values below are the local defaults; both apps work without a .env file.

# --- Local Postgres (docker-compose) ---
POSTGRES_DB=autojournal
POSTGRES_USER=autojournal
POSTGRES_PASSWORD=autojournal
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# JDBC URL without credentials. In production (Supabase) append ?sslmode=require.
DB_URL=jdbc:postgresql://localhost:5432/autojournal
DB_USERNAME=autojournal
DB_PASSWORD=autojournal
SERVER_PORT=8080
# Spring profile: local (default) | test | prod
SPRING_PROFILES_ACTIVE=local
# Comma-separated frontend origins allowed to call /api cross-origin (ADR 0017). Empty locally (Vite proxy).
CORS_ALLOWED_ORIGINS=

# --- Frontend (Vite) ---
# Base URL for API calls. Default "/api" goes through the Vite dev proxy to the backend.
VITE_API_BASE_URL=/api

# --- Supabase Auth (ADR 0013, ADR 0015) — the single Supabase project, values from its dashboard ---
# Project URL, e.g. https://<project-ref>.supabase.co. Backend validates JWTs from <SUPABASE_URL>/auth/v1.
SUPABASE_URL=
# Frontend auth client (never the service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Exchange rates (ADR 0014) — units of currency per 1 EUR; fixed, set by the owner ---
EXCHANGE_RATE_RSD_PER_EUR=117.00
EXCHANGE_RATE_USD_PER_EUR=1.10

# --- E2E (ADR 0015) — test user created in the Supabase project; CI secrets in CI ---
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
