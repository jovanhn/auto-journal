    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.8",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.54.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-redux": "9.3.0",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
