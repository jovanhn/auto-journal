{
  "name": "autojournal-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "gen": "orval --config orval.config.ts",
    "predev": "pnpm gen",
    "dev": "vite",
