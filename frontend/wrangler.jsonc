// Cloudflare Workers static assets (ADR 0017): serves the Vite build; unknown paths fall back to
// index.html so TanStack Router handles them. The API is on Render (VITE_API_BASE_URL at build time).
{
  "name": "auto-journal",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
